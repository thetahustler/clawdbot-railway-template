{
  "version": 1,
  "protocolVersion": 1,
  "providerUpserts": {
    "default": {
      "source": "env"
    }
  },
  "options": {
    "scrubEnv": true,
    "scrubAuthProfilesForProviderTargets": true,
    "scrubLegacyAuthJson": true
  },
  "targets": [
    {
      "type": "gateway.auth.token",
      "path": "gateway.auth.token",
      "pathSegments": ["gateway", "auth", "token"],
      "ref": {
        "source": "env",
        "provider": "default",
        "id": "OPENCLAW_GATEWAY_TOKEN"
      }
    },
    {
      "type": "models.providers.apiKey",
      "path": "models.providers.REPLACE_ME_PRIMARY_ANTHROPIC_PROVIDER_ID.apiKey",
      "pathSegments": ["models", "providers", "REPLACE_ME_PRIMARY_ANTHROPIC_PROVIDER_ID", "apiKey"],
      "providerId": "REPLACE_ME_PRIMARY_ANTHROPIC_PROVIDER_ID",
      "ref": {
        "source": "env",
        "provider": "default",
        "id": "ANTHROPIC_API_KEY"
      }
    },
    {
      "type": "models.providers.apiKey",
      "path": "models.providers.REPLACE_ME_AR_ANTHROPIC_PROVIDER_ID.apiKey",
      "pathSegments": ["models", "providers", "REPLACE_ME_AR_ANTHROPIC_PROVIDER_ID", "apiKey"],
      "providerId": "REPLACE_ME_AR_ANTHROPIC_PROVIDER_ID",
      "ref": {
        "source": "env",
        "provider": "default",
        "id": "ANTHROPIC_API_KEY_AR"
      }
    },
    {
      "type": "models.providers.apiKey",
      "path": "models.providers.REPLACE_ME_MIAMI_ANTHROPIC_PROVIDER_ID.apiKey",
      "pathSegments": ["models", "providers", "REPLACE_ME_MIAMI_ANTHROPIC_PROVIDER_ID", "apiKey"],
      "providerId": "REPLACE_ME_MIAMI_ANTHROPIC_PROVIDER_ID",
      "ref": {
        "source": "env",
        "provider": "default",
        "id": "MIAMI_HONORARY_ANTHROPIC_API_KEY"
      }
    },
    {
      "type": "models.providers.apiKey",
      "path": "models.providers.REPLACE_ME_JOURNAL_ANTHROPIC_PJ_PROVIDER_ID.apiKey",
      "pathSegments": ["models", "providers", "REPLACE_ME_JOURNAL_ANTHROPIC_PJ_PROVIDER_ID", "apiKey"],
      "providerId": "REPLACE_ME_JOURNAL_ANTHROPIC_PJ_PROVIDER_ID",
      "ref": {
        "source": "env",
        "provider": "default",
        "id": "PJ_ANTHROPIC_API_KEY"
      }
    },
    {
      "type": "channels.telegram.accounts.*.botToken",
      "path": "channels.telegram.accounts.default.botToken",
      "pathSegments": ["channels", "telegram", "accounts", "default", "botToken"],
      "accountId": "default",
      "ref": {
        "source": "env",
        "provider": "default",
        "id": "TELEGRAM_BOT_TOKEN"
      }
    },
    {
      "type": "channels.telegram.accounts.*.botToken",
      "path": "channels.telegram.accounts.REPLACE_ME_MIAMI_TELEGRAM_ACCOUNT_ID.botToken",
      "pathSegments": ["channels", "telegram", "accounts", "REPLACE_ME_MIAMI_TELEGRAM_ACCOUNT_ID", "botToken"],
      "accountId": "REPLACE_ME_MIAMI_TELEGRAM_ACCOUNT_ID",
      "ref": {
        "source": "env",
        "provider": "default",
        "id": "MIAMI_HONORARY_TELEGRAM_BOT_TOKEN"
      }
    },
    {
      "type": "channels.telegram.accounts.*.botToken",
      "path": "channels.telegram.accounts.REPLACE_ME_JOURNAL_TELEGRAM_ACCOUNT_ID.botToken",
      "pathSegments": ["channels", "telegram", "accounts", "REPLACE_ME_JOURNAL_TELEGRAM_ACCOUNT_ID", "botToken"],
      "accountId": "REPLACE_ME_JOURNAL_TELEGRAM_ACCOUNT_ID",
      "ref": {
        "source": "env",
        "provider": "default",
        "id": "PUTRA_JOURNAL_TELEGRAM_BOT"
      }
    }
  ]
}
